class RuntimeException <<external>> {
}
class Exception <<external>> {
}

' =========================================
' domain.model.resources
' =========================================

package "domain.model.resources" {

    enum Resource {
        BRICK
        GRAIN
        LUMBER
        ORE
        WOOL
        DESERT
    }

    enum ResourceType {
        WOOD
        BRICK
        SHEEP
        WHEAT
        ORE
        DESERT
    }

    enum Resources {
    }

    class ResourceDeck {
        - {static} TOTAL_NUMBER_OF_RESOURCES : int
        - {static} NUMBER_OF_RESOURCES_PER_DECK : int
        - count : int
        - type : Resource
        + ResourceDeck()
        + ResourceDeck(type : Resource)
        + getType() : Resource
        + draw() : Resource
        + drawMultiple(numCards : int) : int
        + replenish()
        + replenish(numToReplenish : int)
        + replenishAll()
        + getTotalCards() : int
    }

    class ResourceQuantity {
        - resource : Resource
        - quantity : int
        - ResourceQuantity(resource : Resource, quantity : int)
        + {static} create(resource : Resource, quantity : int) : ResourceQuantity
        + getResource() : Resource
        + getQuantity() : int
    }
}

' =========================================
' domain.model.player
' =========================================

package "domain.model.player" {

    enum PlayerColor {
        SETUP
        RED
        BLUE
        ORANGE
        WHITE
    }

    class Player {
        - name : String
        - color : PlayerColor
        - settlements : List<Settlement>
        - roads : List<Road>
        - resources : Map<Resource, Integer>
        - numSettlement : int
        + Player(name : String, color : PlayerColor)
        + getResources() : Map<Resource, Integer>
        + getSettlements() : List<Settlement>
        + placeSettlement()
        + getRoads() : List<Road>
        + placeRoad()
        + receiveResources(resources : Map<Resource, Integer>)
        + getName() : String
        + getColor() : PlayerColor
        + updateResources(resource : Resource, delta : int)
        + getResourceCount(resource : Resource) : int
        + getTotalResourceCount() : int
        + increaseSettlementCount()
        + getSettlementCount() : int
    }

    class TradeManager {
        - offers : List<TradeOffer>
        + offerTrade(offer : TradeOffer)
        + clearOffers()
        + listTrades() : List<TradeOffer>
        + acceptTrade(offer : TradeOffer, acceptingPlayer : Player)
        - validateAcceptTradeInput(offer : TradeOffer, offerer : Player, acceptingPlayer : Player)
        - validateSufficientResources(offerer : Player, acceptingPlayer : Player, giving : ResourceQuantity, receiving : ResourceQuantity)
        - executeTrade(offerer : Player, acceptingPlayer : Player, giving : ResourceQuantity, receiving : ResourceQuantity)
    }

    class TradeOffer {
        - offeringPlayer : Player
        - giving : ResourceQuantity
        - receiving : ResourceQuantity
        - TradeOffer(offeringPlayer : Player, giving : ResourceQuantity, receiving : ResourceQuantity)
        + {static} create(offeringPlayer : Player, giving : ResourceQuantity, receiving : ResourceQuantity) : TradeOffer
        + getOfferingPlayer() : Player
        + getGiving() : ResourceQuantity
        + getReceiving() : ResourceQuantity
    }
}

' =========================================
' domain.model.development_cards
' =========================================

package "domain.model.development_cards" {

    enum DevelopmentCardType {
        KNIGHT
        VICTORY_POINT
        ROAD_BUILDER
        YEAR_OF_PLENTY
        MONOPOLY
    }

    class DevelopmentCard {
        - type : DevelopmentCardType
        - roundDrawnAt : int
        + DevelopmentCard(type : DevelopmentCardType, currentRoundNumber : int)
        + {static} createKnightDevelopmentCard(currentRoundNumber : int) : DevelopmentCard
        + {static} createVictoryPointDevelopmentCard(currentRoundNumber : int) : DevelopmentCard
        + {static} createRoadBuilderDevelopmentCard(currentRoundNumber : int) : DevelopmentCard
        + {static} createYearOfPlentyDevelopmentCard(currentRoundNumber : int) : DevelopmentCard
        + {static} createMonopolyDevelopmentCard(currentRoundNumber : int) : DevelopmentCard
        + isPlayable(currentRoundNumber : int) : boolean
        + getType() : DevelopmentCardType
    }

    class DevelopmentCardDeck {
        - deck : Stack<DevelopmentCard>
        - cardsLeft : int
        - knightCount : int
        - victoryPointCount : int
        - roadBuilderCount : int
        - yearOfPlentyCount : int
        - monopolyCount : int
        + DevelopmentCardDeck()
        + shuffle()
        + drawCard() : DevelopmentCard
        + countRemaining() : int
    }
}

