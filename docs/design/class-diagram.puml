' =========================================
' domain.model
' =========================================

package "domain.model" {

    enum GamePhase {
        BEFORE_ROLL
        RESOURCE_PRODUCTION
        MOVE_ROBBER
        GENERAL_PLAY
        MONOPOLY_DEV_CARD
        ROAD_BUILDING_DEV_CARD
        OFFERING_TRADE
    }

    class GameModel {
        - {static} ROBBER_ROLL_VALUE : int
        - {static} MAX_AMOUNT_SETTLEMENTS : int
        - board : BoardHandler
        - currentGamePhase : GamePhase
        - currentPlayerIndex : int
        - playerColors : List<PlayerColor>
        - currentPlayerColor : PlayerColor
        - playerColorToPlayerObject : Map<PlayerColor, Player>
        - lumberDeck : ResourceDeck
        - brickDeck : ResourceDeck
        - grainDeck : ResourceDeck
        - oreDeck : ResourceDeck
        - woolDeck : ResourceDeck
        - decks : Map<Resource, ResourceDeck>
        + GameModel(players : List<Player>, board : BoardHandler)
        ~ GameModel(lumberDeck : ResourceDeck, brickDeck : ResourceDeck, grainDeck : ResourceDeck, oreDeck : ResourceDeck, woolDeck : ResourceDeck, playerColorToPlayerObject : Map<PlayerColor, Player>, board : BoardHandler)
        + getTurnOrder() : List<Player>
        + getCurrentPlayerIndex() : int
        + getCurrentPlayer() : Player
        + setCurrentPlayerColor(color : PlayerColor)
        + advanceToNextPlayer()
        + getArbitraryPlayer(color : PlayerColor) : Player
        + performTurn(roll : int)
        + interpretRoll(roll : int) : Resource
        + attemptBuildSettlement(nodeID : int)
        + attemptBuildRoad(startingNodeID : int, endingNodeID : int)
        + attemptBuildCity(nodeID : int)
        + endTurn()
        + getCurrentPhase() : GamePhase
        + attemptTrade()
        + playDevCard()
        + buyDevCard()
        + moveRobberAndSteal()
        ~ setCurrentGamePhase(newGamePhase : GamePhase)
        - checkCurrentGamePhaseMatches(expectedGamePhaseOptions : GamePhase...)
        - incrementNumSettlements(playerColorOfInterest : PlayerColor)
        - checkIfPlayerAtMaxSettlements(playerColorOfInterest : PlayerColor)
        - checkPlayerOwnsEnoughResources(playerColorOfInterest : PlayerColor, type : Resource, amountNeeded : int)
        - reducePlayerResources(playerColorOfInterest : PlayerColor, type : Resource, amount : int)
    }

    class GameSetupModel {
        - players : List<Player>
        - usedColors : Set<PlayerColor>
        - usedNames : Set<String>
        - board : BoardHandler
        - resourceDeck : ResourceDeck
        - developmentCardDeck : DevelopmentCardDeck
        - turnOrder : List<Player>
        + GameSetupModel()
        + getPlayerCount() : int
        + addPlayer(name : String, color : PlayerColor)
        + isNameAvailable(name : String) : boolean
        + clearPlayers()
        + getPlayer(index : int) : Player
        + isColorAvailable(color : PlayerColor) : boolean
        + getResourceDeck() : ResourceDeck
        + setResourceDeck(resourceDeck : ResourceDeck)
        + getDevelopmentCardDeck() : DevelopmentCardDeck
        + setDevelopmentCardDeck(developmentCardDeck : DevelopmentCardDeck)
        + determineTurnOrder()
        + getTurnOrder() : List<Player>
        + createGameModel() : GameModel
    }
}

