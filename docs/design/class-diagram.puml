' domain.model.board
' =========================================

package "domain.model.board" {

    class BoardHandler {
        - {static} SETTLEMENT_LEVEL : int
        - {static} CITY_LEVEL : int
        - {static} MIN_HEX_ID : int
        - {static} MAX_HEX_ID : int
        - {static} MIN_NODE_ID : int
        - {static} MAX_NODE_ID : int
        - {static} NUM_NODES : int
        - boardGraphController : BoardGraphController
        - hexes : List<Hex>
        - nodeIdToHexes : Map<Integer, List<Integer>>
        - nodeBuildingLevels : int[]
        - nodeOwners : PlayerColor[]
        - robber : Robber
        + BoardHandler()
        - BoardHandler(boardGraphController : BoardGraphController, hexes : List<Hex>, nodeIdToHexes : Map<Integer, List<Integer>>, robber : Robber)
        + {static} createForTesting(boardGraphController : BoardGraphController, hexes : List<Hex>, nodeIdToHexes : Map<Integer, List<Integer>>, robber : Robber) : BoardHandler
        + buildSettlement(player : Player, nodeId : int)
        + buildCity(player : Player, nodeId : int)
        + addRoad(player : Player, nodeId1 : int, nodeId2 : int)
        + getHexOrder() : List<String>
        + getHexCount() : int
        ~ checkPlayerOwnsNode(playerColor : PlayerColor, nodeId : Integer) : boolean
        ~ getNodeBuildingLevel(nodeId : Integer) : Integer
        ~ awardResources(rollNum : int)
        ~ moveRobber(hexId : int)
        ~ getPlayersOnHex(hexId : int) : Set<Player>
        ~ buildSetupSettlement(player : Player, nodeId : int)
        ~ buildSetupRoad(player : Player, claimedNodeId : int, nodeId1 : int, nodeId2 : int)
        ~ calculateLongestRoad(players : List<Player>, previousWinner : PlayerColor) : PlayerColor
        - initHexes() : List<Hex>
        - {static} initNodeHexMap() : Map<Integer, List<Integer>>
    }

    class BoardGraph {
        - nodeIDToConnectingEdges : Map<Integer, Set<GraphEdge>>
        - nodeIDToNodeObject : Map<Integer, GraphNode>
        ~ addGraphNodeObject(graphNode : GraphNode) : boolean
        ~ addGraphNodeConnection(nodeID : int, connectingEdge : GraphEdge) : boolean
        ~ getGraphNodeByID(nodeID : int) : GraphNode
        ~ getConnectingEdgesByID(nodeID : int) : Set<GraphEdge>
        + checkNodeOccupied(nodeID : int) : boolean
        + checkEdgeOccupied(startingNodeID : int, endingNodeID : int) : boolean
        ~ checkPlayerOwnsGraphNodeObject(color : PlayerColor, nodeID : int) : boolean
        ~ claimGraphNodeObject(color : PlayerColor, nodeID : int) : boolean
        ~ claimGraphEdgeObject(color : PlayerColor, startingNodeID : int, endingNodeID : int) : boolean
        ~ checkIfAdjacentNodesNotClaimed(nodeID : int) : boolean
        ~ getMatchingEdgeFromSet(connectingEdges : Set<GraphEdge>, startingNodeID : int, endingNodeID : int) : GraphEdge
        # edgeCheckPlayerOwnsNeighboringEdge(color : PlayerColor, startingNodeID : int, endingNodeID : int) : boolean
        # edgeCheckPlayerOwnsNeighboringNode(color : PlayerColor, startingNodeID : int, endingNodeID : int) : boolean
        + nodeCheckPlayerOwnsNeighboringEdge(color : PlayerColor, nodeID : int) : boolean
        ~ calculateLongestRoad(players : List<Player>, previousWinner : PlayerColor) : PlayerColor
        ~ buildBoard()
        # checkAmountOfNodesForTesting() : int
        # checkAmountOfNodesInEdgeMapForTesting() : int
        - addGraphEdge(startingNodeID : int, endingNodeID : int)
    }

    class BoardGraphController {
        - boardGraph : BoardGraph
        ~ BoardGraphController(b : BoardGraph)
        ~ playerClaimStoredNodeSetupPhase(color : PlayerColor, nodeID : int) : boolean
        ~ playerClaimStoredEdgeSetupPhase(color : PlayerColor, nodeID : int, startingNodeID : int, endingNodeID : int) : boolean
        ~ playerClaimStoredNode(color : PlayerColor, nodeID : int)
        ~ playerClaimStoredEdge(color : PlayerColor, startingNodeID : int, endingNodeID : int)
        ~ calculateLongestRoad(players : List<Player>, previousWinner : PlayerColor) : PlayerColor
        - checkPlayerOwnsNode(color : PlayerColor, nodeID : int)
        - handleCheckNodeIsUnoccupied(nodeID : int)
        - nodeHandleCheckPlayerOwnsNeighboringEdge(color : PlayerColor, nodeID : int)
        - handleCheckAdjacentNodesNotClaimed(nodeID : int)
        - handleCheckEdgeIsUnoccupied(startingNodeID : int, endingNodeID : int)
        - edgeHandleCheckPlayerOwnsNeighboringEdge(color : PlayerColor, startingNodeID : int, endingNodeID : int)
    }

    class GraphNode {
        - {static} MAX_NODE_ID : int
        - {static} MIN_NODE_ID : int
        - nodeID : int
        - occupied : boolean
        - owningPlayerColor : PlayerColor
        ~ GraphNode(nodeID : int)
        ~ playerClaimNode(color : PlayerColor) : boolean
        ~ checkOccupied() : boolean
        ~ checkColor() : PlayerColor
        ~ getNodeID() : int
        - assertValidNodeID(nodeID : int) : boolean
    }

    class GraphEdge {
        - startingNodeID : int
        - endingNodeID : int
        - roadBuilt : boolean
        - owningPlayerColor : PlayerColor
        ~ GraphEdge(startingNodeID : int, endingNodeID : int)
        ~ claimGraphEdge(color : PlayerColor) : boolean
        ~ checkRoadExists() : boolean
        ~ checkOwningColor() : PlayerColor
        ~ getStartingNodeID() : int
        ~ getEndingNodeID() : int
        - assertValidNodeIDsOrdering(startingNodeID : int, endingNodeID : int) : boolean
    }

    class Hex {
        - {static} MIN_HEX_ID : int
        - {static} MAX_HEX_ID : int
        - {static} MIN_ROLL_NUMBER : int
        - {static} MAX_ROLL_NUMBER : int
        - {static} DESERT_ROLL_NUMBER : int
        - {static} MAX_BUILDINGS_ON_HEX : int
        - {static} SETTLEMENT_RESOURCE_AMOUNT : int
        - {static} CITY_RESOURCE_AMOUNT : int
        - hexId : int
        - resource : Resource
        - hexRollNum : int
        - playerSettlements : List<Player>
        - playerCities : List<Player>
        - totalBuildingsOnHex : int
        ~ Hex(hexId : int, resource : Resource, rollNumber : int)
        ~ addPlayerSettlementToHex(player : Player)
        ~ removePlayerSettlementFromHex(player : Player)
        ~ addPlayerCityToHex(player : Player)
        ~ awardSettlementResources()
        ~ awardCityResources()
        ~ getSettlementCount() : int
        ~ getCityCount() : int
        ~ getHexId() : int
        ~ getHexResource() : Resource
        ~ getHexRollNum() : int
        ~ isPlayerSettlementOnHex(player : Player) : boolean
        ~ isPlayerCityOnHex(player : Player) : boolean
        ~ getHexSettlementPlayers() : List<Player>
        ~ getHexCityPlayers() : List<Player>
        - validateHexId(hexId : int)
        - validateRollNum(rollNumber : int)
        - validateResourceAndHexNumber(resource : Resource, rollNum : int)
    }

    class Edge {
        ~ isOccupied() : boolean
        ~ isConnectedToPlayerNetwork() : boolean
    }

    class Vertex {
        ~ isOccupied() : boolean
        ~ hasAdjacentSettlementViolatingDistanceRule() : boolean
    }
}

